{
  "version": 2,
  "builds": [
    { "src": "nolerstores.html", "use": "@vercel/static" },
    { "src": "seller-dashboard.html", "use": "@vercel/static" },
    { "src": "admin.html", "use": "@vercel/static" },
    { "src": "config.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/$", "dest": "/nolerstores.html" },
    { "src": "/admin$", "dest": "/admin.html" },
    { "src": "/seller-dashboard$", "dest": "/seller-dashboard.html" }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://nolerstores-xwlgba.fly.dev/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://nolerstores-xwlgba.fly.dev/uploads/:path*" }
  ]
}
